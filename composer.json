{
    "name": "omnibase/agenda",
    "description": "Concert dates and venues for omnibase: an Event is a Thread; the agenda page, ICS feeds and imports, Google Calendar links, JSON-LD MusicEvent.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "glitchr/omnibase": "3.0.*-dev",
        "omnibase/admin": "dev-main",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-client": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "symfony/string": "^6.0|^7.0|^8.0",
        "twig/intl-extra": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "omnibase/newsletter": "Adds the coming dates to the newsletter's digest (Digest\\AgendaDigestSource)."
    },
    "autoload": {
        "psr-4": {"Base\\Agenda\\": "./src"}
    },
    "autoload-dev": {
        "psr-4": {"Base\\Agenda\\Tests\\": "./tests"}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
